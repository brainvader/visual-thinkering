## テスト方針（Red → Green）

### store.test.ts に追加

```typescript
describe('isDirty の管理（onNodesChange）', () => {
    beforeEach(() => {
        useStore.setState({
            nodes: [
                { id: 'n1', type: 'entity', position: { x: 0, y: 0 }, data: { ... } },
                { id: 'n2', type: 'relation', position: { x: 100, y: 0 }, data: { ... } },
            ],
            edges: [],
        });
    });

    it('onNodesChange で座標変更があっても isDirty は true にならないこと', () => {
        useStore.getState().markClean();
        const before = useStore.getState().isDirty;

        useStore.getState().onNodesChange([
            { type: 'position', id: 'n1', position: { x: 150, y: 100 } }
        ]);

        const after = useStore.getState().isDirty;
        expect(before).toBe(after);  // 変わらない
    });

    it('onNodesChange で選択フラグが変わっても isDirty は true にならないこと', () => {
        useStore.getState().markClean();

        useStore.getState().onNodesChange([
            { type: 'select', id: 'n1', selected: true }
        ]);

        expect(useStore.getState().isDirty).toBe(false);
    });

    it('addNode で isDirty が true になること', () => {
        useStore.getState().markClean();
        useStore.getState().addNode('entity', { x: 200, y: 200 });
        expect(useStore.getState().isDirty).toBe(true);
    });

    it('deleteNode で isDirty が true になること', () => {
        useStore.getState().markClean();
        useStore.getState().deleteNode('n1');
        expect(useStore.getState().isDirty).toBe(true);
    });

    it('onConnect でエッジ接続時に isDirty が true になること', () => {
        useStore.getState().markClean();

        useStore.getState().onConnect({
            source: 'n1',
            target: 'n2',
            sourceHandle: null,
            targetHandle: null,
        });

        expect(useStore.getState().isDirty).toBe(true);
    });

    it('markClean でリセットできること', () => {
        useStore.getState().markDirty();
        expect(useStore.getState().isDirty).toBe(true);

        useStore.getState().markClean();
        expect(useStore.getState().isDirty).toBe(false);
    });
});
```

